{
  "output_dir": "captures",
  "image_format": "jpg",
  "immediate_guard_trigger": true,
  "idle_seconds_before_guard_trigger": 30,
  "screenshot_interval_seconds": 60,
  "camera_interval_seconds": 300,
  "storage_limit_mb": 500,
  "save_screenshots": true,
  "save_camera_images": true,
  "show_warning_before_lock": true,
  "output_target": "local",
  "email_realtime": false,
  "email_batch_minutes": 5,
  "smtp_host": "smtp.example.com",
  "smtp_port": 587,
  "smtp_user": "your-account@example.com",
  "smtp_password": "your-smtp-auth-code",
  "mail_from": "your-account@example.com",
  "mail_to": "receiver@example.com",
  "encrypt_local_zip": false,
  "zip_password_hint": "请使用 Windows 账户权限或 BitLocker 保护保存目录。",
  "shortcut_guard_mode": "Ctrl+1",
  "shortcut_record_mode": "Ctrl+2",
  "shortcut_stop": "Esc",
  "shortcut_save": "Ctrl+S",
  "shortcut_open_dir": "Ctrl+O",
  "shortcut_export_logs": "Ctrl+E",
  "shortcut_refresh": "F5"
}
